{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "version": 4,
  "logo": {
    "type": "data",
    "source": "  |\\__/,|   (`\\\n  |_ _  |.--.) )\n  ( T   )     /\n (((^_((__((_/",
    "padding": { "top": 2, "right": 4, "bottom": 1 },
    "color": { "1": "magenta" }
  },
  "display": {
    "separator": " ➜  ",
    "key": {
      "width": 4
    }
  },
  "modules": [
    { "type": "os", "key": "\uF307 ", "keyColor": "cyan" },
    { "type": "memory", "key": "\uE266 ", "keyColor": "blue" },
    { "type": "disk", "key": "\uF0C7 ", "keyColor": "yellow" },
    { "type": "localip", "key": "\uF093 ", "keyColor": "green", "compact": true },
    { "type": "netio", "key": "\uF0E4 ", "keyColor": "magenta" },
    "break",
    { "type": "media", "key": "\uF001 ", "keyColor": "magenta", "format": "{1:-15} - {3:-15}" },
    { "type": "weather", "key": "\uF0C2 ", "keyColor": "yellow", "timeout": 500 },
    { "type": "uptime", "key": "\uF017 ", "keyColor": "cyan" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
