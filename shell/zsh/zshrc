# Dotfiles/shell/zsh/zshrc — interactive zsh config (lean, no oh-my-zsh)
#
# Two roles, picked at source time (keep this file syntactically bash-parseable —
# repo validation runs `bash -n`):
#   standalone             -> linked to ~/.zshrc        full config below
#   ml4w Hyprland machine  -> linked to ~/.zshrc_custom  ml4w's loader owns
#     ~/.zshrc and sources this file LAST; only the non-ml4w parts run (aliases,
#     tooling, history, prompt theme). ml4w already provides oh-my-zsh, plugins,
#     completion, fzf and fastfetch — re-running those would double-load.
#
#   ln -s ~/projects/Dotfiles/shell/zsh/zshrc ~/.zshrc          (standalone)
#   ln -s ~/projects/Dotfiles/shell/zsh/zshrc ~/.zshrc_custom   (ml4w; install/bootstrap picks)

# --- Where this repo lives --------------------------------------------------
: "${DOTFILES:=$HOME/projects/Dotfiles}"

# --- ml4w loader? ------------------------------------------------------------
# 1 when ~/.zshrc is the ML4W zshrc loader (ml4w dotfiles own the shell startup).
# Anchored to the loader's banner line so this file never matches itself.
_ml4w_loader=0
grep -qs '^# ML4W zshrc loader' "$HOME/.zshrc" 2>/dev/null && _ml4w_loader=1

# --- Editor -----------------------------------------------------------------
export EDITOR=nvim
export VISUAL="$EDITOR"

# plugins=(
#   git
#   zsh-syntax-highlighting
#   zsh-autosuggestions
# )
# --- History ----------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt extended_history     # timestamps in history
setopt hist_ignore_all_dups # drop older duplicates when a command is re-entered
setopt share_history        # share history across sessions
setopt hist_ignore_space    # lines starting with a space aren't recorded (e.g. secrets)
setopt hist_verify          # !history expansions shown for review, not run blind

# --- Shell behaviour ----------------------------------------------------------
setopt autocd               # type a directory name to cd into it
setopt auto_pushd pushd_ignore_dups # cd pushes a dir stack; use cd -1 / -2 / popd
bindkey -e                  # emacs keybindings (default, explicit)
bindkey '^[[A' up-line-or-search    # up/down arrows search history by prefix
bindkey '^[[B' down-line-or-search
unsetopt flowcontrol        # Ctrl-S/Ctrl-Q do forward search instead of freezing

# --- Completion (zsh native, no framework) -------------------------------------
# Skipped under ml4w: its oh-my-zsh already ran compinit + completion config.
if [ "$_ml4w_loader" -eq 0 ]; then
  autoload -Uz compinit && compinit

  # Match the old oh-my-zsh tab behaviour: complete mid-word, cycle through
  # matches on repeated tab, select from the menu with the arrow keys.
  setopt complete_in_word
  setopt always_to_end
  setopt auto_menu
  zstyle ':completion:*' menu select
  # Case-insensitive + separator/fuzzy matching (oh-my-zsh default matcher list).
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
fi

# --- Zsh plugins (fetched by install/fetch.sh into shell/zsh/plugins/, no oh-my-zsh) ---------
# Syntax highlighting must load last (before the prompt is fine; it rebinds ZLE).
# Skipped under ml4w: its oh-my-zsh already loads autosuggestions + highlighting.
if [ "$_ml4w_loader" -eq 0 ]; then
  [ -f "$DOTFILES/shell/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$DOTFILES/shell/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$DOTFILES/shell/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$DOTFILES/shell/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# --- bun ------------------------------------------------------------------------
[[ -d "$HOME/.bun/bin" ]] && export PATH="$HOME/.bun/bin:$PATH"

# --- local bins (ml4w-dotfiles-installer etc.) ------------------------------------
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# --- Shared aliases (bash + zsh) --------------------------------------------------
source "$DOTFILES/shell/aliases/aliases.sh"

# --- Prompt (Oh My Posh) ----------------------------------------------------------------
# Cross-shell theme (zsh/bash/PowerShell all render shell/oh-my-posh/theme.jsonc).
# Guarded so shells without the binary still work. Bash-parseable on purpose.
if command -v oh-my-posh >/dev/null 2>&1; then
  eval "$(oh-my-posh init zsh --config "$DOTFILES/shell/oh-my-posh/theme.jsonc")"
fi

# --- Blank line between command output and the prompt (visual separation) ------------------
autoload -Uz add-zsh-hook
_zsh_blank_line() { print ""; }
add-zsh-hook precmd _zsh_blank_line

# --- Responsive Fastfetch Definition & Execution ------------------------------------------
# Intercepts fastfetch calls to drop text modules if the terminal window is too small.
fastfetch() {
  whence -p fastfetch >/dev/null 2>&1 || return 0

  local term_width
  term_width=$(tput cols 2>/dev/null || echo 100)

  if [ "$term_width" -lt 90 ]; then
    # Narrow window: suppress all modules using an empty structure string
    command fastfetch -s ""
  else
    # Wide window: run full configured fetch layout
    command fastfetch
  fi
}

# Run it automatically on startup for standalone setups
if [ "$_ml4w_loader" -eq 0 ] && [[ $- == *i* ]]; then
  fastfetch
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
export PATH="$PATH:$HOME/dart/flutter/bin"
# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# opencode
export PATH=$HOME/.opencode/bin:$PATH

# --- wb: wrap a URL into a Tauri webview app via deskify ---------------------
wb() {
  if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: wb <url> <name>"
    echo "Example: wb discord.com Discord"
    return 1
  fi

  local url="$1"
  # Automatically prepend https:// if missing
  if [[ ! "$url" =~ ^[Hh][Tt][Tt][Pp][Ss]?:// ]]; then
    url="https://$url"
  fi

  deskify build --url "$url" --name "$2" --backend tauri
}
export WGPU_BACKEND="gl"

