# Secrets & local-only files — secrets never belong in this repo
.env/
.env.*
*.local
*.bak
credentials
credentials.*
*credentials*
secrets
*.key
*.pem
id_ed25519*
# pi agent credentials (auth.json holds provider API keys; lives in ~/.pi/agent)
auth.json
mcp-auth.json
models-store.json
sessions/
trust.json
# install/code-server.sh downloads into ~/.local, never into the repo
# (historic exclusions for term-profile/ and termux/ artifacts removed with
# those directories)

# Fetched content — install/fetch.sh downloads these; never committed
.agents/
.claude/
shell/zsh/plugins/

# pi extensions dependencies — installed by install/setup (npm ci) into the
# symlinked tree, like any other node_modules
coding-tools/pi/extensions/node_modules/
