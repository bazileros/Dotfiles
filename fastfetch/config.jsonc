{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "  |\\__/,|   (`\\\n  |_ _  |.--.) )\n  ( T   )     /\n (((^_((__((_/",
    "padding": { "top": 2, "right": 3 },
    "color": { "1": "magenta" }
  },
  "display": {
    "separator": " ➜  ",
    "key": { "width": 3 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    "separator",
    { "type": "os", "key": "󰣇 ", "keyColor": "cyan" },
    { "type": "cpu", "key": " ", "keyColor": "blue", "format": "{1}" },
    { "type": "memory", "key": " ", "keyColor": "blue" },
    { "type": "disk", "key": "󰋊 ", "keyColor": "yellow" },
    { "type": "localip", "key": "󰩟 ", "keyColor": "green", "compact": true },
    { "type": "netio", "key": "󰓅 ", "keyColor": "magenta" },
    "break",
    { "type": "media", "key": "󰝚 ", "keyColor": "magenta", "format": "{1} - {3}" },
    { "type": "weather", "key": "󰖐 ", "keyColor": "yellow", "timeout": 1000 },
    { "type": "uptime", "key": "󱎫 ", "keyColor": "cyan" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}